{% set P = m.macro_prefix %}
// Generated by bridgefex from "{{ h.header.include }}". Do not edit.
#ifndef {{ P }}_BUILD
#define {{ P }}_BUILD
#endif

#include "{{ h.c_header }}"
#include "{{ m.runtime_internal_header }}"

#include "{{ h.header.include }}"

extern "C" {
{% for f in h.c_functions %}

// {{ f.description }}
{% if f.returns_status %}
{{ m.status_type }} {{ f.signature }}
{
{% for p in f.null_checked %}
    if ({{ p.name }} == nullptr) {
        return {{ m.detail_namespace }}::null_argument("{{ f.name }}: '{{ p.name }}' is NULL");
    }
{% endfor %}
{% for p in f.null_checked if p.role.value == "out_self" %}
    *{{ p.name }} = nullptr;
{% endfor %}
    return {{ m.detail_namespace }}::guard([&]() { {{ f.statement }} });
}
{% else %}
void {{ f.signature }}
{
    try {
        {{ f.statement }}
    } catch (...) {
        // A destructor that throws cannot report it here, and last_error is
        // left alone because a failed call may not have been inspected yet.
    }
}
{% endif %}
{% endfor %}

}  // extern "C"
