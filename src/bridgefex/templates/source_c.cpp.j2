{% set P = m.macro_prefix %}
// Generated by bridgefex from "{{ h.header.include }}". Do not edit.
#ifndef {{ P }}_C_API_BUILD
#define {{ P }}_C_API_BUILD
#endif

// The wrapped header comes first, as in the library's own sources: macros
// that it defines for the standard headers (_FILE_OFFSET_BITS,
// _GLIBCXX_USE_CXX11_ABI...) then apply here too, so its classes have the same
// layout here as in the library. And a global C++ declaration that clashed
// with a generated C function would be a compile error, not a silent
// redirection.
#if defined(__GLIBC__)
// Something came first (a unity build, a precompiled header): see below.
#define {{ P }}_C_API_AFTER_GLIBC
#endif
#include "{{ h.header.include }}"
#if defined({{ P }}_C_API_AFTER_GLIBC)
// glibc reads these macros in its first header only, so they would not apply.
#if (defined(_FILE_OFFSET_BITS) && _FILE_OFFSET_BITS == 64 && !defined(__USE_FILE_OFFSET64)) || \
    (defined(_TIME_BITS) && _TIME_BITS == 64 && defined(__TIMESIZE) && __TIMESIZE == 32 && \
     !defined(__USE_TIME_BITS64))
#error "{{ h.header.include }} sets _FILE_OFFSET_BITS or _TIME_BITS, but a system header was included before it: its classes would not have the library's layout. Compile this file as its own translation unit, without a precompiled header."
#endif
#undef {{ P }}_C_API_AFTER_GLIBC
#endif
{% for other in h.foreign_headers %}
{% if loop.first %}

// The headers of the value structs of other headers that this one uses.
{% endif %}
#include "{{ other.header.include }}"
{% endfor %}

#include "{{ h.c_header }}"
#include "{{ m.runtime_internal_header }}"
{% for name in h.std_includes %}
#include <{{ name }}>
{% endfor %}

// The code below names the wrapped declarations to expose them, deprecated
// ones too: that is no reason to warn here. Nor is a member that a default
// constructor of the user leaves uninitialized: it is copied as it is.
#if defined(__GNUC__) || defined(__clang__)
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
#if !defined(__clang__)
#pragma GCC diagnostic ignored "-Wmaybe-uninitialized"
#endif
#elif defined(_MSC_VER)
#pragma warning(push)
#pragma warning(disable : 4996)
#endif
{% for name in h.internal_includes %}
{% if loop.first %}

{% endif %}
#include "{{ name }}"
{% endfor %}
{% for e in h.enums %}
{% if loop.first %}

// The C types and constants of the enums must be the C++ ones, with this
// compiler and these options.
{% endif %}
{% if e.model.fixed %}
static_assert(std::is_same<std::underlying_type<{{ e.cpp_name }}>::type, {{ e.model.underlying.c_name }}>::value,
              "{{ e.model.qualified_name }}: the underlying type is not {{ e.model.underlying.c_name }}");
{% endif %}
{% for x in e.enumerators %}
static_assert(static_cast<{{ e.model.underlying.c_name if e.model.fixed else "long long" }}>({{ e.cpp_name }}::{{ x.model_name }}) == {{ x.macro }},
              "{{ e.model.qualified_name }}::{{ x.model_name }} is not {{ x.macro }}");
{% endfor %}
{% endfor %}
{% for e in h.foreign_enums %}
{% if loop.first %}

// Enums of other headers, which may only be declared here.
{% endif %}
static_assert(std::is_same<std::underlying_type<{{ e.cpp_name }}>::type, {{ e.model.underlying.c_name }}>::value,
              "{{ e.model.qualified_name }}: the underlying type is not {{ e.model.underlying.c_name }}");
{% endfor %}
{% if h.classes %}

#if !defined(__cpp_aligned_new)
// Before C++17, new ignores alignments larger than the default one.
{% for c in h.classes %}
static_assert(alignof({{ c.cpp_name }}) <= {{ m.detail_namespace }}::new_alignment,
              "{{ c.model.qualified_name }} is over-aligned: compile this file as C++17 or later");
{% endfor %}
#endif
{% endif %}

extern "C" {
{% for f in h.c_functions %}

// {{ f.description }}
{% if f.returns_status %}
{{ m.status_type }} {{ f.signature }}
{
{% for check in f.compile_checks %}
    {{ check }}
{% endfor %}
{% for c, reset in f.owned_outputs %}
    if ({{ c.condition }}) {
        return {{ m.detail_namespace }}::{{ c.helper }}("{{ f.name }}: {{ c.message }}");
    }
    {{ reset }}
{% endfor %}
{% for c in f.checks %}
    if ({{ c.condition }}) {
        return {{ m.detail_namespace }}::{{ c.helper }}("{{ f.name }}: {{ c.message }}");
    }
{% endfor %}
    return {{ m.detail_namespace }}::guard([&]() { {{ f.statement }} });
}
{% else %}
void {{ f.signature }}
{
    // A destructor that throws cannot report it here, and last_error is left
    // alone because a failed call may not have been inspected yet.
    {{ m.detail_namespace }}::guard_silently([&]() { {{ f.statement }} });
}
{% endif %}
{% endfor %}

}  // extern "C"

#if defined(__GNUC__) || defined(__clang__)
#pragma GCC diagnostic pop
#elif defined(_MSC_VER)
#pragma warning(pop)
#endif
