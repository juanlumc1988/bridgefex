{% set P = m.macro_prefix %}
/* Generated by bridgefex. Do not edit. */
/* Runtime support shared by every header of the "{{ m.name }}" C API. */
#ifndef {{ P }}_RUNTIME_H
#define {{ P }}_RUNTIME_H

#include <stddef.h>
#include <stdint.h>
#ifndef __cplusplus
#include <stdbool.h>
#endif

/*
 * {{ P }}_API marks the exported functions. Define {{ P }}_STATIC when the C API
 * is built or used as a static library. The generated sources define
 * {{ P }}_BUILD themselves.
 */
#if defined({{ P }}_STATIC)
#  define {{ P }}_API
#elif defined(_WIN32) || defined(__CYGWIN__)
#  if defined({{ P }}_BUILD)
#    define {{ P }}_API __declspec(dllexport)
#  else
#    define {{ P }}_API __declspec(dllimport)
#  endif
#elif defined(__GNUC__) && __GNUC__ >= 4
#  define {{ P }}_API __attribute__((visibility("default")))
#else
#  define {{ P }}_API
#endif

/*
 * {{ P }}_NODISCARD asks the compiler to warn when a status is ignored: C++17
 * and C23 [[nodiscard]] (GCC 13/14 report C23 as 202000L), else the GNU
 * attribute, else nothing.
 */
#if defined(__cplusplus) && (__cplusplus >= 201703L || (defined(_MSVC_LANG) && _MSVC_LANG >= 201703L))
#  define {{ P }}_NODISCARD [[nodiscard]]
#elif !defined(__cplusplus) && defined(__STDC_VERSION__) && __STDC_VERSION__ > 201710L && defined(__has_c_attribute)
#  if __has_c_attribute(nodiscard)
#    define {{ P }}_NODISCARD [[nodiscard]]
#  endif
#endif
#if !defined({{ P }}_NODISCARD) && defined(__GNUC__)
#  define {{ P }}_NODISCARD __attribute__((warn_unused_result))
#endif
#if !defined({{ P }}_NODISCARD)
#  define {{ P }}_NODISCARD
#endif

/* Result of every function that can fail. */
typedef int32_t {{ m.status_type }};

/* Success. */
#define {{ P }}_OK 0
/* The C++ code threw a std::exception; {{ m.last_error }}() has its what(). */
#define {{ P }}_ERROR_EXCEPTION 1
/* The C++ code threw something that is not a std::exception. */
#define {{ P }}_ERROR_UNKNOWN_EXCEPTION 2
/* A pointer argument was NULL. */
#define {{ P }}_ERROR_NULL_ARGUMENT 3
/* Memory allocation failed (std::bad_alloc). */
#define {{ P }}_ERROR_OUT_OF_MEMORY 4

#ifdef __cplusplus
extern "C" {
#endif

/*
 * Message of the last error on the calling thread, in UTF-8 when the C++ code
 * uses UTF-8. Never NULL. Only meaningful right after a call that returned
 * something other than {{ P }}_OK: successful calls and destroy functions
 * leave it alone, and the next failing call on the same thread overwrites it.
 */
{{ P }}_API const char* {{ m.last_error }}(void);

/*
 * Fingerprint of this C API: it changes whenever a generated declaration
 * changes. Bindings compare it to detect a stale library.
 */
{{ P }}_API const char* {{ m.api_fingerprint_function }}(void);

#ifdef __cplusplus
}
#endif

#endif /* {{ P }}_RUNTIME_H */
