#  define {{ P }}_NODISCARD [[nodiscard]]
#elif !defined(__cplusplus) && defined(__STDC_VERSION__) && __STDC_VERSION__ > 201710L && defined(__has_c_attribute)
#  if __has_c_attribute(nodiscard)
#    define {{ P }}_NODISCARD [[nodiscard]]
#  endif
#endif
