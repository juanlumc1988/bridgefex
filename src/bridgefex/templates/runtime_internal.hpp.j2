    } catch (const std::exception& error) {
        set_last_error(error.what());
        return {{ P }}_ERROR_EXCEPTION;
    } catch (...) {
        set_last_error("unknown C++ exception");
        return {{ P }}_ERROR_UNKNOWN_EXCEPTION;
    }
}

