{% set P = m.macro_prefix %}
/* Generated by bridgefex. Do not edit. */
/* Types of the "{{ m.name }}" C API: the opaque handles and enums of every header. */
#ifndef {{ P }}_TYPES_H
#define {{ P }}_TYPES_H

#include "{{ m.runtime_header }}"
{% for h in m.headers if h.types %}

/* From "{{ h.header.include }}". */
{% for t in h.types %}
{% if t is class_plan %}

/* Opaque handle of {{ t.model.qualified_name }}. */
typedef struct {{ t.c_type }} {{ t.c_type }};
{% else %}

/* {{ t.comment }} */
typedef {{ t.model.underlying.c_name }} {{ t.c_type }};
{% for e in t.enumerators %}
#define {{ e.macro }} {{ e.literal }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}

#endif /* {{ P }}_TYPES_H */
