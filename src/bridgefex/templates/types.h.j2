{% set P = m.macro_prefix %}
/* Generated by bridgefex. Do not edit. */
/* Types of the "{{ m.name }}" C API: the opaque handles, enums and value structs of every header. */
#ifndef {{ P }}_TYPES_H
#define {{ P }}_TYPES_H

#include "{{ m.runtime_header }}"

/*
 * The natural layout, whatever packing is in effect where this header is
 * included (a #pragma pack that another header left, /Zp, -fpack-struct).
 */
#pragma pack(push, 8)
{% for h in m.headers if h.types %}

/* From "{{ h.header.include }}". */
{% for t in h.types %}
{% if t is class_plan %}

/* Opaque handle of {{ t.model.qualified_name }}. */
typedef struct {{ t.c_type }} {{ t.c_type }};
{% else %}

/* {{ t.comment }} */
typedef {{ t.model.underlying.c_name }} {{ t.c_type }};
{% for e in t.enumerators %}
#define {{ e.macro }} {{ e.literal }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% for s in m.structs %}
{% if loop.first %}

/* Value structs, each after the structs it contains. */
{% endif %}

/* {{ s.model.qualified_name }} */
typedef struct {{ s.c_type }} {
{% for f in s.fields %}
    {{ f.c_declaration }};
{% endfor %}
} {{ s.c_type }};
{% endfor %}

#pragma pack(pop)

#endif /* {{ P }}_TYPES_H */
