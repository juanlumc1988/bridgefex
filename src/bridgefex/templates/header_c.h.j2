{% set P = m.macro_prefix %}
/* Generated by bridgefex from "{{ h.header.include }}". Do not edit. */
#ifndef {{ h.guard }}
#define {{ h.guard }}

#include "{{ m.runtime_header }}"
{% if h.classes %}

/* Opaque handles. In C++ they are the wrapped classes themselves. */
#ifdef __cplusplus
{% for c in h.classes %}
{% for ns in c.model.namespace %}
namespace {{ ns }} {
{% endfor %}
{{ c.model.class_key }} {{ c.model.name }};
{% for ns in c.model.namespace | reverse %}
}  /* namespace {{ ns }} */
{% endfor %}
typedef {{ c.cpp_name }} {{ c.c_type }};
{% endfor %}
#else
{% for c in h.classes %}
typedef struct {{ c.c_type }} {{ c.c_type }};
{% endfor %}
#endif
{% endif %}

#ifdef __cplusplus
extern "C" {
#endif
{% for f in h.c_functions %}

/* {{ f.description }} */
{% if f.returns_status %}
{{ P }}_NODISCARD {{ P }}_API {{ m.status_type }} {{ f.signature }};
{% else %}
{{ P }}_API void {{ f.signature }};
{% endif %}
{% endfor %}

#ifdef __cplusplus
}
#endif

#endif /* {{ h.guard }} */
