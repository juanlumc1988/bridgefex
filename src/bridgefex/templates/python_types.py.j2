{# The body first: only the modules that it uses are imported. #}
{% set body %}
# The package, wherever it was copied to (pickle finds the types by module).
_PACKAGE = __name__.rpartition(".")[0]
{% for h in m.headers %}
{% for t in h.types %}
{% if t is class_plan %}


class {{ t.struct_name }}(ctypes.Structure):
    """Opaque C handle of {{ t.model.qualified_name }}."""


{{ t.pointer_name }} = ctypes.POINTER({{ t.struct_name }})
{% else %}

{{ t.c_type }} = enum.IntEnum(
    "{{ t.py_name }}",
    [{% for e in t.enumerators %}("{{ e.py_name }}", {{ e.value }}){{ ", " if not loop.last else "" }}{% endfor %}],
    module=_PACKAGE + ".{{ t.py_module.partition('.')[2] }}",
    qualname="{{ t.py_qualname }}",
)
{{ t.c_type }}.__doc__ = "Wraps ``{{ t.model.description }}``."
{% endif %}
{% endfor %}
{% endfor %}
{% for s in m.structs %}


class {{ s.mirror }}(ctypes.Structure):
    """C mirror of {{ s.model.qualified_name }} ({{ s.c_type }})."""

    _fields_ = [
{% for f in s.fields %}
        ("{{ f.ctypes_name }}", {{ f.ctypes_type }}),
{% endfor %}
    ]


def {{ s.mirror }}__post_init(self):
    _runtime.fill_defaults(self, {{ s.mirror }}__default)


{{ s.c_type }} = dataclasses.make_dataclass(
    "{{ s.py_name }}",
    [
{% for f in s.fields %}
        ("{{ f.name }}", {{ f.py_annotation }}, dataclasses.field(default=_runtime.DEFAULT)),
{% endfor %}
    ],
    namespace={"__post_init__": {{ s.mirror }}__post_init},
    slots=True,
)
{{ s.c_type }}.__module__ = _PACKAGE + ".{{ s.py_module.partition('.')[2] }}"
{{ s.c_type }}.__qualname__ = "{{ s.py_qualname }}"
{{ s.c_type }}.__doc__ = (
    "Value of ``{{ s.model.qualified_name }}``. Omitted members take their value in a "
    "default-constructed ``{{ s.model.qualified_name }}``, which loads the library."
)
{% for e in s.enums %}
{{ s.c_type }}.{{ e.py_name }} = {{ e.c_type }}
{% endfor %}


def {{ s.mirror }}__default():
    raw = {{ s.mirror }}()
    _runtime.check(_bind().{{ s.init.name }}(raw))
    return {{ s.mirror }}__from_c(raw)


def {{ s.mirror }}__fill(raw, value, name):
    _runtime.check_struct(value, {{ s.c_type }}, name)
{% for f in s.fields %}
{% for line in f.fill %}
    {{ line }}
{% endfor %}
{% endfor %}


def {{ s.mirror }}__to_c(value, name):
    raw = {{ s.mirror }}()
    {{ s.mirror }}__fill(raw, value, name)
    return raw


def {{ s.mirror }}__from_c(raw):
    return {{ s.c_type }}(
{% for f in s.fields %}
        {{ f.read }},
{% endfor %}
    )
{% endfor %}
{% if m.structs %}


_lib = None
# Reentrant: a finalizer or signal handler that calls into this module can run
# while _bind() declares the signatures, in the same thread.
_bind_lock = _runtime.reset_after_fork(threading.RLock())


def _bind():
    """Load the library on first use and declare the C signatures."""
    global _lib
    if _lib is not None:
        return _lib
    # Outside the lock: load() takes a lock of its own.
    lib = _runtime.library()
    with _bind_lock:
        if _lib is None:
{% for s in m.structs %}
            lib.{{ s.init.name }}.argtypes = {{ s.init.ctypes_argtypes }}
            lib.{{ s.init.name }}.restype = {{ s.init.ctypes_restype }}
{% endfor %}
            _lib = lib
    return _lib
{% endif %}
{% endset %}
"""Types of the "{{ m.name }}" bindings: the handles, enums and value structs of every header.

Generated by bridgefex. Do not edit. The header modules export these types.
"""

{% for module in ("ctypes", "dataclasses", "enum", "threading") if module + "." in body %}
import {{ module }}
{% endfor %}
{% if "_runtime." in body %}

from . import _runtime
{% endif %}

{{ body }}